+    def test_ack_candidate_store_reuse_and_reopen(self):
+        with self.database() as db:
+            source = self.sources(db)
+            stored = self.invoke(db, reason="RECEIPT_STORED")
+            raw = support.canonical(self.expected_p(db, db.ack_raw))
+            self.assertEqual({"receipt_bytes": raw, "receipt_sha256": support.sha(raw)}, stored["record"])
+            self.assertEqual([(*db.key, raw, support.sha(raw))], receipt_rows(db.peer_receipt))
+            self.assertEqual(0x41515231, db.receipt.execute("PRAGMA application_id").fetchone()[0])
+            self.assertEqual(1, db.receipt.execute("PRAGMA user_version").fetchone()[0])
+            pinned = receipt_snapshot(db.receipt, db.receipt_path)
+            self.assertEqual(stored["record"], self.invoke(db, reason="RECEIPT_REUSED")["record"])
+            variants = [json.dumps(db.ack, indent=2, ensure_ascii=True).encode(),
+                        json.dumps(dict(queuedSubmission=dict(reversed(list(db.ack["queuedSubmission"].items())))), separators=(",", ":")).encode()]
+            spans = copy.deepcopy(db.ack)
+            spans["queuedSubmission"]["input"][0]["text_elements"] = []
+            variants.append(support.canonical(spans))
+            variants.append(db.ack_raw + b" "*(262144-len(db.ack_raw)))
+            changed = copy.deepcopy(db.ack)
+            changed["queuedSubmission"]["id"] = "different-valid-queued-id"
+            variants.append(support.canonical(changed))
+            for ack in variants:
+                self.assertNotEqual(support.sha(db.ack_raw), support.sha(ack))
+                self.invoke(db, ack=ack, reason="RECEIPT_CONFLICT")
+                self.assertEqual(pinned, receipt_snapshot(db.receipt, db.receipt_path))
+                self.assertEqual(source, self.sources(db))
+            for role in ("intent", "binding", "receipt"):
+                getattr(db, role).close()
+                setattr(db, role, support.connect(getattr(db, role + "_path")))
+            observed = self.invoke(db, "read_queue_receipt", receipt_pin=support.sha(raw), reason="RECEIPT_OBSERVED")
+            self.assertEqual(stored["record"], observed["record"])
+            self.assertEqual(source, self.sources(db))
+            file_raw = db.receipt_path.read_bytes()
+            for private in (db.raw, db.ack_raw, self.data["prompt_fixture"].encode(), self.data["intent"]["dev_root"].encode()):
+                self.assertNotIn(private, file_raw)
