+    def test_unknown_receipt_is_immutable(self):
+        for code in (None, "RPC_REQUEST_TIMEOUT", "UNCLASSIFIED_LOCAL_OR_TRANSPORT_ERROR"):
+            with self.subTest(code=code), self.database() as db:
+                source = self.sources(db)
+                stored = self.invoke(db, ack=None, code=code, reason="RECEIPT_STORED")
+                raw = support.canonical(self.expected_p(db, None, code))
+                self.assertEqual(raw, stored["record"]["receipt_bytes"])
+                pinned = receipt_snapshot(db.receipt, db.receipt_path)
+                self.assertEqual(stored["record"], self.invoke(db, ack=None, code=code, reason="RECEIPT_REUSED")["record"])
+                self.invoke(db, reason="RECEIPT_CONFLICT")  # A later valid ACK cannot overwrite UNKNOWN.
+                alternatives = sorted(ALLOWED_CODES) if code is None else ["RPC_CONNECT_FAILED"]
+                for other in alternatives:
+                    self.invoke(db, ack=None, code=other, reason="RECEIPT_CONFLICT")
