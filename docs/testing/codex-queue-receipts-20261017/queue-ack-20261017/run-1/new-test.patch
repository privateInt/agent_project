+def receipt_rows(connection):
+    if not connection.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='queue_receipts'").fetchone():
+        return []
+    return connection.execute("SELECT project_id,batch_id,task_id,receipt_bytes,receipt_sha256 "
+                              "FROM queue_receipts ORDER BY 1,2,3").fetchall()
+
+
+def receipt_snapshot(connection, path):
+    return {"objects": connection.execute("SELECT type,name,tbl_name,sql FROM sqlite_master ORDER BY 1,2").fetchall(),
+            "rows": receipt_rows(connection), "app": connection.execute("PRAGMA application_id").fetchone()[0],
+            "version": connection.execute("PRAGMA user_version").fetchone()[0], "bytes": path.read_bytes()}
