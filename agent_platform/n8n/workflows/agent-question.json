    {
      "id": "8301d01e-c31f-5463-85ae-0a08addd3836",
      "name": "Question settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{json:JSON.parse(\"{\\\"base_url\\\": \\\"http://agent-gateway:8000\\\", \\\"agent_version_id\\\": \\\"00000000-0000-0000-0000-000000000000\\\", \\\"question\\\": \\\"선택한 자료의 연구 범위는 무엇인가요?\\\"}\")}];"
      },
      "position": [
        220,
        0
      ]
    },
    {
      "id": "cc5959f3-bfb4-5ac2-8d13-cdc363e53a53",
      "name": "Prepare request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const x=$input.first().json;\nconst uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;\nif (typeof x.base_url!=='string'||!/^https?:\\/\\/[^\\s/?#@]+(?::\\d+)?$/.test(x.base_url)) throw Error('Configure the Agent Gateway origin');\nlet request=x.request;\nif (!request) {\n  const mode=x.mode||'run';if(!['run','test'].includes(mode))throw Error('Choose run or test mode');\n  if(!uuid.test(x.agent_version_id)||x.agent_version_id==='00000000-0000-0000-0000-000000000000')throw Error('Choose a published Agent version');\n  if(typeof x.question!=='string'||!x.question.trim()||x.question.includes('\\0')||Buffer.byteLength(x.question,'utf8')>8192)throw Error('Question must be nonblank and at most 8 KiB');\n  // Stable inside this execution; HTTP retries consume this saved output.\n  const hex=require('crypto').createHash('sha256').update(String($workflow.id)+'/'+String($execution.id)+'/agent-call').digest('hex');\n  const key=hex.slice(0,8)+'-'+hex.slice(8,12)+'-4'+hex.slice(13,16)+'-a'+hex.slice(17,20)+'-'+hex.slice(20,32);\n  request={invocation_key:key,body:{agent_version_id:x.agent_version_id,mode,input:{question:x.question},caller_context:{system:'n8n',workflow_id:String($workflow.id),execution_id:String($execution.id),node_id:'agent-call'}}};\n}\nif(!uuid.test(request.invocation_key)||!uuid.test(request.body?.agent_version_id)||!['run','test'].includes(request.body.mode)||typeof request.body.input?.question!=='string'||!request.body.input.question.trim()||request.body.input.question.includes('\\0')||Buffer.byteLength(request.body.input.question,'utf8')>8192||!request.body.caller_context?.execution_id)throw Error('Invalid replay envelope: preserve the original key, body and caller_context');\nreturn [{json:{base_url:x.base_url,request,started_ms:Date.now(),trace:{workflow_id:String($workflow.id),execution_id:String($execution.id)}}}];"
      },
      "position": [
        440,
        0
      ]
    },
    {
      "id": "7e1a3cb1-7532-5dc3-b6c9-0654c47fbc50",
      "name": "Accept Agent run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 8000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        },
        "method": "POST",
        "url": "={{ $json.base_url + \"/api/agent-runs\" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.request.invocation_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request.body) }}"
      },
      "position": [
        660,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "22104023-e8be-5965-bbec-d114860ad0e8",
      "name": "Run pointer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const p=$('Prepare request').first().json,r=$input.first().json;\nconst b=r.body;\nif(r.statusCode!==202||!b||b.state!=='accepted'||!/^[-0-9a-f]{36}$/.test(b.agent_run_id)||b.agent_version_id!==p.request.body.agent_version_id||b.status_url!=='/api/agent-runs/'+b.agent_run_id)throw Error('Invalid Agent acceptance; preserve Prepare request output before retry');\nreturn [{json:{...p,agent_run_id:b.agent_run_id,status_url:b.status_url}}];"
      },
      "position": [
        880,
        0
      ]
    },
    {
