    {
      "id": "3d3f37dc-c858-5206-8bc1-e037b6bf21c1",
      "name": "Evaluate state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const p=$('Run pointer').first().json,r=$input.first().json,b=r.body;\nif(r.statusCode!==200||!b||b.agent_run_id!==p.agent_run_id||b.agent_version_id!==p.request.body.agent_version_id||!['accepted','running','succeeded','failed','interrupted'].includes(b.state))throw Error('Invalid Agent status; use the saved run ID to look up the result');\nlet keep_waiting=['accepted','running'].includes(b.state);\nconst timed_out=keep_waiting&&(Date.now()-p.started_ms>=650000||$runIndex>=300);\nif(timed_out)keep_waiting=false;\nif(b.state==='succeeded'&&(!b.result||!['answered','no_evidence'].includes(b.result.outcome)||typeof b.result.answer!=='string'||!Array.isArray(b.result.citations)||(b.result.outcome==='answered'&&!b.result.citations.length)))throw Error('Invalid final Agent result');\nreturn [{json:{...p,keep_waiting,succeeded:b.state==='succeeded',state:timed_out?'poll_timeout':b.state,request_id:b.request_id||'',tool_call_id:b.tool_call_id||'',result:b.result||null,error:timed_out?{code:'POLL_TIMEOUT',stage:'poll'}:b.error||null,poll_count:$runIndex+1}}];"
      },
      "position": [
