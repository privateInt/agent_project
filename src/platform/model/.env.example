# Example only. Replace placeholders privately; never commit real values.
# One PostgreSQL connection is enough.
# Each service automatically creates its own database on first startup:
#   model_operations, model_management, model_training, model_deployment
# The role must have CREATEDB privilege for the first bootstrap.
MODEL_POSTGRES_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@postgres:5432/postgres?sslmode=disable
MODEL_KAFKA_BROKERS=ops-kafka:19092
MODEL_KAFKA_COMMAND_TOPIC=ops.operations.requested
MODEL_KAFKA_CONSUMER_GROUP=model-platform-dispatchers

MODEL_MINIO_ENDPOINT=ops-minio1:9000
MODEL_MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MODEL_MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MODEL_MINIO_BUCKET=model-artifacts
MODEL_MINIO_USE_SSL=false
# ---------------------------------------------------------
# MLflow Training tracking
# ---------------------------------------------------------
# Internal Docker-network URI used by one-shot Training Jobs.
MODEL_MLFLOW_TRACKING_URI=http://ops-mlflow:5000
# Browser-facing URI saved into result_json as mlflow_run_url.
MODEL_MLFLOW_PUBLIC_URI=http://127.0.0.1:5000
MODEL_MLFLOW_EXPERIMENT_NAME=model-platform-training
# System metrics are best-effort; GPU metrics require nvidia-ml-py in the job image.
MODEL_MLFLOW_ENABLE_SYSTEM_METRICS_LOGGING=true
MODEL_MLFLOW_SYSTEM_METRICS_SAMPLING_INTERVAL=5
MODEL_MLFLOW_SYSTEM_METRICS_SAMPLES_BEFORE_LOGGING=1

# Platform-owned AES-256 key for encrypting short-lived user credentials.
# Generate once with: openssl rand -base64 32
MODEL_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Docker dispatcher host identity. Required only when API requests node_name.
MODEL_DISPATCHER_NODE_NAME=
AGENT_PROJECT_NETWORK=ops-infra
MODEL_GATEWAY_PORT=13000
